---
import "$styles/global.css";

import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import uofg from "$img/uofg.webp";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <title>uofg.webr.ing</title>
  </head>
  <body>
    <header class="bg-hero p-8 min-w-full flex flex-col items-center prose-lg">
      <h1 class="flex items-center gap-2 mb-0"> 
        <Image
          src={uofg}
          alt="University of Glasgow"
          class="size-16"
        />
        University of Glasgow
      </h1>

      <p>{"{{ ring_description }}"}</p>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>
        made with <Icon name="mdi:heart" class="inline align-middle" /> by
        <a href={"{{ ring_owner_site }}"}>{"{{ ring_owner }}"}</a>
      </p>
      <p>not affiliated with or endorsed by the University of Glasgow. powered by <a href="https://github.com/k3rs3d/ringfairy">ringfairy</a>.</p>
    </footer>
  </body>
</html>

<style>
  @reference "$styles/global.css";

  p {
    @apply text-muted text-center;
  }
</style>
