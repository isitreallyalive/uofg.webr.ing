---
import Page from "$page";
import { Icon } from "astro-icon/components";
---

<Page>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 w-10/12 sm:w-2/3 lg:w-1/2 gap-6 mx-auto mt-6">
    {"{% for site in sites %}"}
      <div class="bg-ctp-crust p-4 rounded-xl flex text-lg items-center shadow-md hover:shadow-lg transition-shadow justify-between">
        <span class="font-medium text-center sm:text-left">{"{{ site.website.name }}"}</span>
        <div class="flex gap-2">
          {"{% if site.website.rss %}"}
            <a href="{{ site.website.rss }}" class="hover:text-ctp-mauve transition-colors">
              <Icon name="mdi:rss" class="text-2xl" />
            </a>
          {"{% endif %}"}
          <a href="{{ site.website.url }}">
            <Icon name="mdi:open-in-new" class="text-2xl hover:text-ctp-mauve transition-colors" />
          </a>
        </div>
      </div>
    {"{% endfor %} "}
  </div>
</Page>
